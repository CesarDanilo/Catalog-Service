# Variáveis da stack de PRODUÇÃO (docker-compose.prod.yml). Copie para .env.production na EC2
# e preencha — o .env.production nunca vai pro git.

# Senha do Postgres do catálogo. Obrigatória. Gere uma forte: openssl rand -hex 24
CATALOG_DB_PASSWORD=

# IP onde a API publica a porta 3333. Na EC2: o IP PRIVADO da instância (ex.: 172.31.x.x), pro
# backend alcançar pela VPC. Nunca 0.0.0.0 — a API não tem autenticação. Padrão: 127.0.0.1.
CATALOG_API_BIND=

# Sincronização periódica das lojas (C&A, Renner...) — mantém o catálogo atualizado.
SCHEDULER_ENABLED=true

LOG_LEVEL=info
# Limite por IP/minuto. Só o backend do provador chama esta API, então pode ser folgado.
RATE_LIMIT_MAX=300
# Intervalo mínimo entre requisições à mesma loja (ms) — scraping responsável.
CRAWLER_REQUEST_DELAY=1000
