# ---------- Aplicação ----------
NODE_ENV=development
PORT=3333
HOST=0.0.0.0
LOG_LEVEL=info
# Origens permitidas (separadas por vírgula). Nunca use "*" em produção.
CORS_ORIGIN=http://localhost:3000
# Limite de corpo das requisições (bytes)
BODY_LIMIT=1048576
# Timeout de requisições HTTP recebidas (ms)
REQUEST_TIMEOUT=15000

# ---------- Infraestrutura ----------
# O Postgres do docker-compose é exposto na porta 5433 do host.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/catalog?schema=public
REDIS_URL=redis://localhost:6379

# ---------- Rate limit ----------
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
# IPs/redes fora do limite (ex.: o backend). Vale o IP da conexão, nunca o X-Forwarded-For.
RATE_LIMIT_ALLOWLIST=

# ---------- Cache (segundos) ----------
CACHE_TTL=300
CACHE_PRODUCT_TTL=600

# ---------- Crawlers ----------
CRAWLER_TIMEOUT=30000
CRAWLER_MAX_RETRIES=3
# Intervalo mínimo entre requisições à mesma fonte (ms)
CRAWLER_REQUEST_DELAY=1000
CRAWLER_CONCURRENCY=1
CRAWLER_USER_AGENT=CatalogServiceBot/0.1 (+https://github.com/your-org/catalog-service)
# Liga/desliga o agendador de sincronizações periódicas no worker
SCHEDULER_ENABLED=false
# Lojas desligadas sem mexer no banco (slugs separados por vírgula, ex.: amazon,ca).
# Ficam fora do registro: sync manual responde CRAWLER_NOT_AVAILABLE e o agendador não agenda.
CRAWLER_DISABLED_SOURCES=
# Peça não vista numa sincronização completa há mais de N dias vira indisponível (saiu da loja).
STALE_PRODUCT_DAYS=3

# ---------- Google Shopping (busca ao vivo: GET /api/v1/providers/google-shopping/search) ----------
# disabled | serpapi | browser. "serpapi" = API paga e autorizada (produção).
# "browser" = Playwright, só pra testes locais: o Google responde CAPTCHA a tráfego automatizado
# e isso NUNCA é contornado (a busca falha com GOOGLE_SHOPPING_BLOCKED).
GOOGLE_SHOPPING_FETCHER=disabled
# Obrigatória com GOOGLE_SHOPPING_FETCHER=serpapi.
GOOGLE_SHOPPING_SERPAPI_KEY=
# Mercado padrão (a requisição pode trocar country/language).
GOOGLE_SHOPPING_COUNTRY=BR
GOOGLE_SHOPPING_LANGUAGE=pt-BR
GOOGLE_SHOPPING_DOMAIN=google.com.br
GOOGLE_SHOPPING_CURRENCY=BRL
# Limites conservadores: 1 busca por vez, 3s entre inícios, até 5 esperando (o resto recebe 503).
GOOGLE_SHOPPING_MAX_CONCURRENCY=1
GOOGLE_SHOPPING_MAX_QUEUE=5
GOOGLE_SHOPPING_REQUEST_DELAY_MS=3000
# Prazos (ms): busca inteira / navegação ou chamada à API / espera pelos cartões na página.
GOOGLE_SHOPPING_TIMEOUT_MS=25000
GOOGLE_SHOPPING_NAVIGATION_TIMEOUT_MS=15000
GOOGLE_SHOPPING_SELECTOR_TIMEOUT_MS=8000
# Tentativas por busca (só falhas passageiras; bloqueio nunca é repetido).
GOOGLE_SHOPPING_MAX_ATTEMPTS=2
# Produtos guardados por busca (a paginação anda sobre esse lote) e cache do lote (segundos).
GOOGLE_SHOPPING_MAX_PRODUCTS=60
GOOGLE_SHOPPING_CACHE_TTL=3600
